{
  "name": "good-card",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @good-card/web dev",
    "dev:api": "pnpm --filter @good-card/api dev",
    "build": "pnpm --filter @good-card/web build && pnpm --filter @good-card/api build",
    "lint": "eslint .",
    "preview": "pnpm --filter @good-card/web preview",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:destroy": "docker compose down -v && docker compose up -d",
    "db:psql": "docker compose exec db psql -U goodcard -d goodcard",
    "start": "pnpm --filter @good-card/api start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  }
}
